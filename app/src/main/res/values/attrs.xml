<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="EasySwipeMenuLayout">
        <attr name="leftMenuView" format="reference" />
        <attr name="rightMenuView" format="reference" />
        <attr name="contentView" format="reference" />
        <attr name="canRightSwipe" format="boolean" />
        <attr name="canLeftSwipe" format="boolean" />
        <attr name="fraction" format="float" />
    </declare-styleable>

    <declare-styleable name="circlePercentBar">
        <attr name="arcColor" format="color" />
        <attr name="arcWidth" format="dimension" />
        <attr name="centerTextColor" format="color" />
        <attr name="centerTextSize" format="dimension" />
        <attr name="circleRadius" format="dimension" />
        <attr name="arcProgressColor" format="color" />
        <attr name="arcCircleBgColor" format="color" />
    </declare-styleable>

    <declare-styleable name="circleSectorView">
        <attr name="outerRadius" format="dimension" />
        <attr name="sectorBackgroundColor" format="color" />
        <attr name="sectorGradualStartColor" format="color" />
        <attr name="sectorGradualEndColor" format="color" />
        <attr name="innerRadius" format="dimension" />
        <attr name="innerCircleColor" format="color" />
        <attr name="triangleRadius" format="dimension" />
        <attr name="triangleColor" format="color" />
        <attr name="triangleSide" format="dimension" />
        <attr name="triangleHeight" format="dimension" />
    </declare-styleable>

    <declare-styleable name="fontPaddingTextView">
        <attr name="fontPaddingTop" format="boolean" />
        <attr name="fontPaddingBottom" format="boolean" />
    </declare-styleable>

    <declare-styleable name="dynamicLayout">
        <attr name="iconWidth" format="reference|dimension|enum">
            <enum name="wrap_content" value="-2" />
            <enum name="match_parent" value="-1" />
            <enum name="fill_parent" value="-1" />
        </attr>
        <attr name="iconHeight" format="reference|dimension|enum">
            <enum name="wrap_content" value="-2" />
            <enum name="match_parent" value="-1" />
            <enum name="fill_parent" value="-1" />
        </attr>
        <attr name="iconUrl" format="reference" />
        <attr name="contentWidth" format="reference|dimension|enum">
            <enum name="wrap_content" value="-2" />
            <enum name="match_parent" value="-1" />
            <enum name="fill_parent" value="-1" />
        </attr>
        <attr name="contentHeight" format="reference|dimension|enum">
            <enum name="wrap_content" value="-2" />
            <enum name="match_parent" value="-1" />
            <enum name="fill_parent" value="-1" />
        </attr>
        <attr name="contentText" format="string" />
        <attr name="contentColor" format="color|reference" />
        <attr name="contentSize" format="dimension" />
        <attr name="contentMaxLine" format="reference|integer" />
        <attr name="unitWidth" format="reference|dimension|enum">
            <enum name="wrap_content" value="-2" />
            <enum name="match_parent" value="-1" />
            <enum name="fill_parent" value="-1" />
        </attr>
        <attr name="unitHeight" format="reference|dimension|enum">
            <enum name="wrap_content" value="-2" />
            <enum name="match_parent" value="-1" />
            <enum name="fill_parent" value="-1" />
        </attr>
        <attr name="unitText" format="string" />
        <attr name="unitColor" format="color" />
        <attr name="unitSize" format="dimension" />
    </declare-styleable>
</resources>